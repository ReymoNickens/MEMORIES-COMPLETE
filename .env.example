# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Paystack — engineers set live keys. Demo issue is OFF unless EVOLVEIT_DEMO=1
# and PAYSTACK_SECRET_KEY is not sk_live.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Ticket TOTP at rest — 32-byte hex. Required when EVOLVEIT_DEMO is not 1.
# openssl rand -hex 32
TICKET_MASTER_KEY=

# Staff session HMAC. Required when EVOLVEIT_DEMO is not 1.
STAFF_SESSION_SECRET=
PIN_PEPPER=

# Meta WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# SMS (Arkesel)
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Memories

# Hub
HUB_SECRET=
HUB_LAN_URL=http://hub.lan
HUB_SYNC_INTERVAL_MS=60000
# Used by apps/hub/src/index.ts and db.ts respectively — documented here
# because they were live env vars with no entry in this file.
HUB_PORT=3001
HUB_DB_PATH=./hub.db

# The door scanner's browser bundle talks to the hub directly over the venue
# LAN. Read by apps/web/src/app/(staff)/scanner/page.tsx.
NEXT_PUBLIC_HUB_URL=http://hub.lan:3001

# App
NEXT_PUBLIC_APP_URL=https://memories.evolveit.io
APP_URL=https://memories.evolveit.io
CRON_SECRET=

# Local only. Never set this on a host that has sk_live.
# EVOLVEIT_DEMO=1
